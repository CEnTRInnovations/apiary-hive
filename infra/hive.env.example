# Copy to /opt/centrinnovations/apiary-hive/infra/.env.prod and fill values.
# Keep this file private: it grants access to the optional owner-only default
# AI provider.
LLM_TIMEOUT_SECONDS=30
OWNER_ACCESS_TOKEN=
# Powers both the owner-gated default provider (bundle review + embeddings) and the
# Jev fast pre-filter. Leave blank to disable both.
OPENROUTER_API_KEY=
# Optional overrides — defaults in backend/config.py already point at current OpenRouter models.
# OPENROUTER_CHAT_MODEL=mistralai/mistral-small-3.2-24b-instruct
# OPENROUTER_EMBED_MODEL=mistralai/mistral-embed-2312
